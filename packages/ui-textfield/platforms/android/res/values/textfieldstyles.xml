<?xml version="1.0" encoding="utf-8"?>
<resources
    xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="NSUiTextFieldTextInputEditText"
        parent="@style/Widget.Material3.TextInputEditText.FilledBox">
        <item name="backgroundColor">@null</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="NSUiTextFieldThemeOverlay"
        parent="@style/ThemeOverlay.Material3.TextInputEditText.FilledBox">
        <item name="editTextStyle">@style/NSUiTextFieldTextInputEditText</item>
    </style>
    <style name="NSUiTextFieldShapeAppearanceOverlay" parent="">
    </style>
    <style name="NSUiTextFieldTextInputLayout"
        parent="@style/Widget.Material3.TextInputLayout.FilledBox">
        <item name="materialThemeOverlay">@style/NSUiTextFieldThemeOverlay</item>
        <item name="boxBackgroundColor">@null</item>
        <item name="boxBackgroundMode">none</item>
        <item name="boxCollapsedPaddingTop">3dp</item>
        <!-- <item name="boxStrokeWidth">0dp</item> -->

        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
    </style>
    <style name="NSUiTextFieldTextInputLayout_Filled"
        parent="@style/Widget.Material3.TextInputLayout.FilledBox">
    </style>
    <style name="NSUiTextFieldTextInputLayout_Outlined"
        parent="@style/Widget.Material3.TextInputLayout.OutlinedBox">
    </style>
</resources>