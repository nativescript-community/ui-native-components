<?xml version="1.0" encoding="utf-8"?>
<resources
    xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="NSUiTextViewTextInputEditText"
        parent="@style/Widget.Material3.TextInputEditText.FilledBox">
        <item name="backgroundColor">@null</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
    </style>
    <style name="NSUiTextViewThemeOverlay"
        parent="@style/ThemeOverlay.Material3.TextInputEditText.FilledBox">
        <item name="editTextStyle">@style/NSUiTextViewTextInputEditText</item>
    </style>
    <style name="NSUiTextViewShapeAppearanceOverlay" parent="">

    </style>
    <style name="NSUiTextViewTextInputLayout"
        parent="@style/Widget.Material3.TextInputLayout.FilledBox">
        <item name="materialThemeOverlay">@style/NSUiTextViewThemeOverlay</item>
        <item name="boxBackgroundColor">@null</item>
        <item name="boxBackgroundMode">none</item>
        <item name="boxCollapsedPaddingTop">3dp</item>
        <!-- <item name="boxStrokeWidth">0dp</item> -->

        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
    </style>
    <style name="NSUiTextViewTextInputLayout_Filled"
        parent="@style/Widget.Material3.TextInputLayout.FilledBox">
    </style>
    <style name="NSUiTextViewTextInputLayout_Outlined"
        parent="@style/Widget.Material3.TextInputLayout.OutlinedBox">
    </style>
</resources>