{
    "name": "@nativescript-community/ui-bottomsheet",
    "version": "1.4.2",
    "description": "BottomSheet: showBottomSheet()/closeBottomSheet() on every View. Material on Android, native UISheetPresentationController on iOS.",
    "main": "./index",
    "sideEffects": false,
    "typings": "./index.d.ts",
    "scripts": {
        "tsc": "cpy '**/*.d.ts' '../../packages/ui-bottomsheet' --parents --cwd=../../src/ui-bottomsheet && tsc  --build",
        "readme": "readme generate -c ../../tools/readme/blueprint.json",
        "build": "npm run tsc && npm run readme",
        "build.watch": "npm run tsc -- -w",
        "build.all": "npm run build",
        "clean": "bin/rimraf ./*.d.ts ./*.js ./*.js.map ./*.tsbuildinfo ./*.mjs ./*.mjs.map ./angular ./svelte ./vue* ./react"
    },
    "nativescript": {
        "platforms": {
            "android": "6.2.0",
            "ios": "6.2.0"
        }
    },
    "keywords": [
        "NativeScript",
        "JavaScript",
        "Android",
        "iOS"
    ],
    "author": {
        "name": "Martin Guillon",
        "email": "martin@akylas.fr"
    },
    "bugs": {
        "url": "https://github.com/nativescript-community/ui-native-components/issues"
    },
    "license": "Apache-2.0",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/nativescript-community/ui-native-components/tree/master/packages/ui-bottomsheet#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/nativescript-community/ui-native-components.git",
        "directory": "packages/ui-bottomsheet"
    },
    "readmeFilename": "README.md",
    "dependencies": {
        "@nativescript-community/ui-core": "^1.4.2"
    }
}
