{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": "../../src/ui-activityindicator",
        "outDir": "./",
        "paths": {
            "@nativescript-community/ui-core": [
                "packages/ui-core/index"
            ],
            "@nativescript-community/ui-core/*": [
                "packages/ui-core/*"
            ]
        }
    },
    "include": [
        "../../src/ui-activityindicator/**/*.ts",
        "../../references.d.ts",
        "../../tools/references.d.ts",
        "../../src/references.d.ts"
    ],
    "exclude": [
        "../../src/ui-activityindicator/angular/**"
    ]
}
