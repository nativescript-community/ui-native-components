{
    "name": "@nativescript-community/ui-refreshlayout",
    "version": "1.0.1",
    "description": "Pull to refresh at the top and the bottom of a scrollable view: SwipeRefreshLayout on Android, UIRefreshControl on iOS. Made for CollectionView and chat UX.",
    "main": "./index",
    "sideEffects": false,
    "typings": "./index.d.ts",
    "scripts": {
        "tsc": "cpy '**/*.d.ts' '../../packages/ui-refreshlayout' --parents --cwd=../../src/ui-refreshlayout && tsc  --build",
        "readme": "readme generate -c ../../tools/readme/blueprint.json",
        "build": "npm run tsc && npm run readme",
        "build.watch": "npm run tsc -- -w",
        "build.all": "npm run build",
        "clean": "bin/rimraf ./*.d.ts ./*.js ./*.js.map ./*.tsbuildinfo ./*.mjs ./*.mjs.map ./angular ./svelte ./vue* ./react"
    },
    "nativescript": {
        "platforms": {
            "android": "6.2.0",
            "ios": "6.2.0"
        }
    },
    "keywords": [
        "NativeScript",
        "JavaScript",
        "Android",
        "iOS"
    ],
    "author": {
        "name": "Martin Guillon",
        "email": "martin@akylas.fr"
    },
    "bugs": {
        "url": "https://github.com/nativescript-community/ui-native-components/issues"
    },
    "license": "Apache-2.0",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/nativescript-community/ui-native-components/tree/master/packages/ui-refreshlayout#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/nativescript-community/ui-native-components.git",
        "directory": "packages/ui-refreshlayout"
    },
    "readmeFilename": "README.md",
    "dependencies": {
        "@nativescript-community/ui-core": "^1.0.1"
    }
}
