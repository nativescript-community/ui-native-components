        "@nativescript-community/ui-bottomsheet": "*",
        "@nativescript-community/ui-button": "*",
        "@nativescript-community/ui-core": "*",
        "@nativescript-community/ui-core-tabs": "*",
        "@nativescript-community/ui-dialogs": "*",
        "@nativescript-community/ui-floatingactionbutton": "*",
        "@nativescript-community/ui-progress": "*",
        "@nativescript-community/ui-slider": "*",
        "@nativescript-community/ui-snackbar": "*",
        "@nativescript-community/ui-switch": "*",
        "@nativescript-community/ui-tabs": "*",
        "@nativescript-community/ui-textfield": "*",
        "@nativescript-community/ui-textview": "*",
        "@nativescript/hook": "~2.0.0",
