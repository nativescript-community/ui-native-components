{
    "name": "@nativescript-community/template-snippet",
    "version": "0.0.1",
    "private": true,
    "nativescript": {
        "platforms": {
            "android": "*",
            "ios": "*"
        },
        "hooks": [
            {
                "type": "after-prepare",
                "script": "scripts/after-prepare.js",
                "inject": true
            }
